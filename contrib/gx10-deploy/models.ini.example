# Installed to /etc/llama-server/models.ini by install.sh (not overwritten on
# re-install if it already exists there - edit the live copy, not this file).
# See tools/server/README.md "Model presets" for the full format.
#
# hf-repo is required explicitly in each section below: a section name that
# merely LOOKS like an HF repo:quant string is not enough on its own - the
# router only auto-infers a model's source from an already-known match
# (a cache hit, or a --models-dir scan), and does nothing to fetch one on a
# cold cache. Without hf-repo here, a spawned child gets --alias/--ctx-size/
# --n-gpu-layers but no actual model source, and silently sits idle as an
# empty router instead of loading or erroring clearly.
#
# Check that each hf-repo actually exists before trusting a failure message.
# A repo that does not exist (or is gated) does NOT report 404: the Hugging
# Face API answers an anonymous request with
#   GET failed (401): Invalid username or password
# because it will not confirm or deny the existence of a private repo to an
# unauthenticated caller. So a plain typo in a repo name surfaces as what
# looks exactly like a credentials problem, and sends you hunting for an
# HF_TOKEN that was never needed. Verify with:
#   curl -o /dev/null -w '%{http_code}\n' https://huggingface.co/api/models/<owner>/<repo>
# 200 = exists and is public; 401 = nonexistent, misspelled, or gated.
#
# Note in particular that Qwen publishes GGUF conversions for only some of
# their models - there is no Qwen/Qwen3-Coder-*-GGUF, only third-party
# conversions such as unsloth's below. Qwen/Qwen3-32B-GGUF is official.

version = 1

[*]
ctx-size = 32768
n-gpu-layers = 999

[unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M]
hf-repo = unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M
load-on-startup = true

[Qwen/Qwen3-32B-GGUF:Q4_K_M]
hf-repo = Qwen/Qwen3-32B-GGUF:Q4_K_M
load-on-startup = true
