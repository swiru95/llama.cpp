# Installed to /etc/llama-server/config.yaml by install.sh (not overwritten on
# re-install if it already exists there - edit the live copy, not this file).
#
# See docs: --config loads any documented server flag from YAML; this fork
# adds an optional inline `auth_policy:` block for RBAC (see PLAN.md / README).

port: 8080

# Router mode: which models are available and how many stay loaded at once.
# The actual model list lives in models.ini alongside this file.
models-preset: /etc/llama-server/models.ini
models-max: 2
models-autoload: true

# CHANGE THIS before starting the service. Generate a real key with:
#   openssl rand -hex 32
api-key: "sk-CHANGE-ME-before-starting"

# JSON-lines audit log: one line per non-public request, hashed subject,
# never a raw key/token. See docs/design/pr2-principal-proxy.md.
auth-audit-log: /var/log/llama-server/audit.jsonl

# Uncomment and fill in to require RBAC roles instead of the single flat
# --api-key above (each key mapped to a role - no key here means deny):
#
# auth_policy:
#   roles:
#     admin: [INFER, READ_STATE, METRICS, ADMIN_STATE, ADMIN_MODELS]
#     user: [INFER]
#   api_keys:
#     "<sha256-hex-of-the-key>": admin
#   default_role: null

# Uncomment to require an OIDC bearer token instead of / in addition to keys:
#
# oidc-issuer: "https://login.microsoftonline.com/<tenant-id>/v2.0"
# oidc-audience: "<app-registration-client-id>"
