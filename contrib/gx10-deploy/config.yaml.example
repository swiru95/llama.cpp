# Installed to /etc/llama-server/config.yaml by install.sh (not overwritten on
# re-install if it already exists there - edit the live copy, not this file).
#
# DO NOT put port / models-preset / models-max / models-autoload / api-key
# here. The router hands its own --config argument down to every spawned
# child verbatim, and each child re-parses this file independently from
# scratch - so a router-only key here would make every child think it
# should also be a router and spawn two more children, recursively,
# without bound. Those settings live directly on the systemd unit's
# ExecStart line (llama-server.service) instead, where they get correctly
# stripped before being handed to children. This file is only for settings
# that ARE fine (or even desirable) to also apply identically to every
# spawned model instance.
#
# See docs: --config loads any documented server flag from YAML; this fork
# adds an optional inline `auth_policy:` block for RBAC (see PLAN.md / README).

# JSON-lines audit log: one line per non-public request, hashed subject,
# never a raw key/token. See docs/design/pr2-principal-proxy.md.
auth-audit-log: /var/log/llama-server/audit.jsonl

# Uncomment and fill in to require RBAC roles instead of the flat
# --api-key-file the unit already sets (each key mapped to a role - a key
# with no entry here is denied, not silently admitted):
#
# auth_policy:
#   roles:
#     admin: [INFER, READ_STATE, METRICS, ADMIN_STATE, ADMIN_MODELS]
#     user: [INFER]
#   api_keys:
#     "<sha256-hex-of-the-key>": admin
#   default_role: null

# Uncomment to require an OIDC bearer token instead of / in addition to keys:
#
# oidc-issuer: "https://login.microsoftonline.com/<tenant-id>/v2.0"
# oidc-audience: "<app-registration-client-id>"
