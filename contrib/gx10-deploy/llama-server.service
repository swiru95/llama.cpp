[Unit]
Description=llama-server (RBAC/mTLS/OIDC auth fork)
Documentation=https://github.com/swiru95/llama.cpp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llama-server
Group=llama-server
WorkingDirectory=/var/lib/llama-server

Environment=LLAMA_CACHE=/var/lib/llama-server/cache
Environment=LD_LIBRARY_PATH=@INSTALL_PREFIX@/bin
# Hygiene, not a bug fix: keep any system-wide token or registry-mirror
# override out of this service's environment (Ubuntu's systemd reads
# /etc/environment into every service by default). The models this unit
# serves are public, so a credential reaching the downloader can only ever
# be an accident, and a mirror override would silently change where model
# weights are fetched from.
#
# It must be UnsetEnvironment=, never Environment=KEY= : the latter sets an
# EMPTY value, which is not the same as absent. common_get_model_endpoint
# (common/common.cpp) only checks whether the env var pointer is non-null,
# not whether it is non-empty, so an empty-but-present HF_ENDPOINT is read
# as "the base URL is the empty string" and breaks resolution outright
# ("invalid URL: no scheme") instead of falling back to the default.
# Confirmed by hitting exactly that failure with the Environment=KEY= form.
UnsetEnvironment=HF_TOKEN MODEL_ENDPOINT HF_ENDPOINT

# Router-identity flags (models-preset/models-max/models-autoload/port/
# api-key) MUST be given here on the command line, never inside the
# --config file below. The router hands its own --config argument down to
# every spawned child verbatim, and each child re-parses that file
# independently from scratch - so a router-only key inside it would make
# every child think it should also be a router and spawn two more
# children, recursively, without bound. Settings that ARE fine to also
# apply identically to every child instance (audit log, RBAC/OIDC/mTLS)
# belong in config.yaml instead.
ExecStart=@INSTALL_PREFIX@/bin/llama-server --port 8080 --models-preset /etc/llama-server/models.ini --models-max 2 --models-autoload --api-key-file /etc/llama-server/api.key --config /etc/llama-server/config.yaml

Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening. GPU access needs /dev/nvidia* device nodes - do NOT set
# PrivateDevices=true here. install.sh adds the service user to whichever
# of "video"/"render" owns those nodes on this system; if inference fails
# with a CUDA init error after install, check `ls -l /dev/nvidia*` against
# `id llama-server` and add the missing group manually.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llama-server /var/log/llama-server
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RemoveIPC=true
UMask=0027

[Install]
WantedBy=multi-user.target
